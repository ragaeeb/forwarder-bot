# Existing (keep)
BOT_TOKEN=your_telegram_bot_token
SECRET_TOKEN=your_webhook_secret_token

# Database driver selection
DB_DRIVER=sqlite                   # "sqlite" | "turso" | "mongodb"

# SQLite (default for local dev)
SQLITE_PATH=./data/forwarder.db

# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# MongoDB
MONGODB_URI=mongodb://localhost:27017/forwarder-bot

# Next.js
NEXTAUTH_URL=http://localhost:3000   # used for webhook URL construction

# DynamoDB (only needed for migration script)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
TABLE_NAME=telegram-forwarder-bot-table
