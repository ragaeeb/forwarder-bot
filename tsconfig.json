{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "sourceMap": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "outDir": "./dist",
        "jsx": "preserve",
        "incremental": true,
        "noEmit": true,
        "allowJs": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "~/*": ["./*"]
        },
        "lib": ["dom", "dom.iterable", "esnext"]
    },
    "include": [
        "./src/**/*",
        "app/**/*",
        "components/**/*",
        "lib/**/*",
        "scripts/**/*",
        "test/**/*",
        "next-env.d.ts",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "test/**/*"]
}
