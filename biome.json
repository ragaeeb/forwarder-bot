{
    "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "error",
                "noUnusedImports": "error",
                "noUnusedFunctionParameters": "warn"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useTemplate": "off"
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noArrayIndexKey": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true,
            "cssModules": true
        }
    },
    "files": {
        "includes": ["**", "!node_modules", "!dist", "!.next", "!coverage", "!components/ui"]
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx", "test/**/*"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "correctness": {
                        "noUnusedVariables": "warn",
                        "noUnusedFunctionParameters": "off"
                    }
                }
            }
        }
    ]
}
