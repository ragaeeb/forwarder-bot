{
    "name": "telegram-forwarder-bot",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "biome check --write .",
        "format": "biome format --write .",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "webhook:setup": "bun scripts/manageHook.ts --setup",
        "webhook:reset": "bun scripts/manageHook.ts --reset",
        "webhook:reveal": "bun scripts/manageHook.ts --reveal",
        "migrate": "bun scripts/migrateDynamoToSQLite.ts",
        "migrate:dry": "bun scripts/migrateDynamoToSQLite.ts --dry-run",
        "db:seed": "bun scripts/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.777.0",
        "@aws-sdk/lib-dynamodb": "^3.778.0",
        "@libsql/client": "^0.17.0",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-toast": "^1.2.15",
        "better-sqlite3": "^12.6.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "env-var": "^7.5.0",
        "lucide-react": "^0.575.0",
        "mongoose": "^9.2.3",
        "next": "15",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "react": "19",
        "react-dom": "19",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.4",
        "@happy-dom/global-registrator": "^20.7.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/aws-lambda": "^8.10.148",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.13.14",
        "@types/react": "19",
        "@types/react-dom": "19",
        "typescript": "^5.8.2"
    },
    "engines": {
        "bun": ">=1.3.10"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/forwarder-bot.git"
    },
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "description": "Telegram bot that forwards messages between users and a group with topics"
}
